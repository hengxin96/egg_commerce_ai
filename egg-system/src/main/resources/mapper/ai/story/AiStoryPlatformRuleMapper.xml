<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.egg.commerce.system.mapper.ai.story.AiStoryPlatformRuleMapper">

    <!-- 平台画像和规则 SQL 映射，供剧情任务运行时读取已发布规则。 -->
    <resultMap id="AiStoryPlatformRuleResult" type="com.egg.commerce.system.domain.ai.story.AiStoryPlatformRule">
        <id property="id" column="id"/>
        <result property="platform" column="platform"/>
        <result property="version" column="version"/>
        <result property="status" column="status"/>
        <result property="platformProfile" column="platform_profile"/>
        <result property="categoryRules" column="category_rules"/>
        <result property="sourceSummary" column="source_summary"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 查询指定平台最新发布规则，任务会保存规则 ID 和版本以便追踪。 -->
    <select id="selectPublishedRuleByPlatform" parameterType="String" resultMap="AiStoryPlatformRuleResult">
        select id,
               platform,
               version,
               status,
               platform_profile,
               category_rules,
               source_summary,
               created_by,
               created_at,
               updated_at
        from ai_story_platform_rules
        where platform = #{platform}
          and status = 'published'
        order by updated_at desc, created_at desc
        limit 1
    </select>
</mapper>
