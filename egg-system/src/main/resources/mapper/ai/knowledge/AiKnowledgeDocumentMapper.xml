<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.egg.commerce.system.mapper.ai.knowledge.AiKnowledgeDocumentMapper">

    <!-- 知识库文档 SQL 映射，负责后台列表、上传元数据、状态更新和批量删除。 -->
    <resultMap id="AiKnowledgeDocumentResult" type="com.egg.commerce.system.domain.ai.knowledge.AiKnowledgeDocument">
        <id property="id" column="id"/>
        <result property="fileName" column="file_name"/>
        <result property="fileExt" column="file_ext"/>
        <result property="mimeType" column="mime_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="ossBucket" column="oss_bucket"/>
        <result property="ossObjectKey" column="oss_object_key"/>
        <result property="ossUrl" column="oss_url"/>
        <result property="vectorStore" column="vector_store"/>
        <result property="vectorCollection" column="vector_collection"/>
        <result property="vectorIds" column="vector_ids"/>
        <result property="chunkCount" column="chunk_count"/>
        <result property="status" column="status"/>
        <result property="failureReason" column="failure_reason"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="completedAt" column="completed_at"/>
    </resultMap>

    <sql id="selectAiKnowledgeDocumentVo">
        select id,
               file_name,
               file_ext,
               mime_type,
               file_size,
               oss_bucket,
               oss_object_key,
               oss_url,
               vector_store,
               vector_collection,
               vector_ids::text as vector_ids,
               chunk_count,
               status,
               failure_reason,
               created_by,
               created_at,
               updated_at,
               completed_at
        from ai_knowledge_documents
    </sql>

    <!-- 按 ID 查询知识库文档详情。 -->
    <select id="selectAiKnowledgeDocumentById" parameterType="String" resultMap="AiKnowledgeDocumentResult">
        <include refid="selectAiKnowledgeDocumentVo"/>
        where id = cast(#{id} as uuid)
    </select>

    <!-- 批量查询文档详情，用于下载地址生成和删除前资源清理。 -->
    <select id="selectAiKnowledgeDocumentByIds" parameterType="String" resultMap="AiKnowledgeDocumentResult">
        <include refid="selectAiKnowledgeDocumentVo"/>
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            cast(#{id} as uuid)
        </foreach>
    </select>

    <!-- 后台知识库列表查询，支持文件名、状态和创建人筛选。 -->
    <select id="selectAiKnowledgeDocumentList"
            parameterType="com.egg.commerce.system.domain.ai.knowledge.AiKnowledgeDocument"
            resultMap="AiKnowledgeDocumentResult">
        <include refid="selectAiKnowledgeDocumentVo"/>
        <where>
            <if test="id != null and id != ''">
                and id = cast(#{id} as uuid)
            </if>
            <if test="fileName != null and fileName != ''">
                and file_name like concat('%', #{fileName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="createdBy != null">
                and created_by = #{createdBy}
            </if>
        </where>
        order by created_at desc
    </select>

    <!-- 保存上传后的知识库文档元数据。 -->
    <insert id="insertAiKnowledgeDocument"
            parameterType="com.egg.commerce.system.domain.ai.knowledge.AiKnowledgeDocument">
        insert into ai_knowledge_documents (
            id,
            file_name,
            file_ext,
            mime_type,
            file_size,
            oss_bucket,
            oss_object_key,
            oss_url,
            vector_store,
            vector_collection,
            vector_ids,
            chunk_count,
            status,
            failure_reason,
            created_by,
            created_at,
            updated_at,
            completed_at
        ) values (
            cast(#{id} as uuid),
            #{fileName},
            #{fileExt},
            #{mimeType},
            #{fileSize},
            #{ossBucket},
            #{ossObjectKey},
            #{ossUrl},
            #{vectorStore},
            #{vectorCollection},
            cast(#{vectorIds} as jsonb),
            #{chunkCount},
            #{status},
            #{failureReason},
            #{createdBy},
            #{createdAt},
            #{updatedAt},
            #{completedAt}
        )
    </insert>

    <!-- 回写知识库文档处理状态、向量 ID 和失败原因。 -->
    <update id="updateAiKnowledgeDocument"
            parameterType="com.egg.commerce.system.domain.ai.knowledge.AiKnowledgeDocument">
        update ai_knowledge_documents
        set file_name = #{fileName},
            file_ext = #{fileExt},
            mime_type = #{mimeType},
            file_size = #{fileSize},
            oss_bucket = #{ossBucket},
            oss_object_key = #{ossObjectKey},
            oss_url = #{ossUrl},
            vector_store = #{vectorStore},
            vector_collection = #{vectorCollection},
            vector_ids = cast(#{vectorIds} as jsonb),
            chunk_count = #{chunkCount},
            status = #{status},
            failure_reason = #{failureReason},
            created_by = #{createdBy},
            created_at = #{createdAt},
            updated_at = #{updatedAt},
            completed_at = #{completedAt}
        where id = cast(#{id} as uuid)
    </update>

    <!-- 批量删除知识库文档元数据，外部资源清理由服务层先执行。 -->
    <delete id="deleteAiKnowledgeDocumentByIds" parameterType="String">
        delete from ai_knowledge_documents
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            cast(#{id} as uuid)
        </foreach>
    </delete>

</mapper>
