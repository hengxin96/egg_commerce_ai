<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.egg.commerce.system.mapper.ai.chat.AiChatMessageMapper">

    <!-- 智能聊天消息 SQL 映射，负责消息查询和落库字段绑定。 -->
    <resultMap id="AiChatMessageResult" type="com.egg.commerce.system.domain.ai.chat.AiChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="userId" column="user_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="modelName" column="model_name"/>
        <result property="promptVersion" column="prompt_version"/>
        <result property="ragUsed" column="rag_used"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 查询会话消息，按创建时间还原前端聊天顺序。 -->
    <select id="selectAiChatMessageListBySessionId" parameterType="String" resultMap="AiChatMessageResult">
        select id,
               session_id,
               user_id,
               role,
               content,
               model_name,
               prompt_version,
               rag_used,
               created_at
        from ai_chat_messages
        where session_id = cast(#{sessionId} as uuid)
        order by created_at asc
    </select>

    <!-- 保存用户消息或助手消息，RAG 来源记录由独立表维护。 -->
    <insert id="insertAiChatMessage" parameterType="com.egg.commerce.system.domain.ai.chat.AiChatMessage">
        insert into ai_chat_messages (
            id,
            session_id,
            user_id,
            role,
            content,
            model_name,
            prompt_version,
            rag_used,
            created_at
        ) values (
            cast(#{id} as uuid),
            cast(#{sessionId} as uuid),
            #{userId},
            #{role},
            #{content},
            #{modelName},
            #{promptVersion},
            #{ragUsed},
            #{createdAt}
        )
    </insert>

</mapper>
