<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.egg.commerce.system.mapper.ai.chat.AiChatSessionMapper">

    <!-- 智能聊天会话 SQL 映射，负责会话列表、创建和摘要更新。 -->
    <resultMap id="AiChatSessionResult" type="com.egg.commerce.system.domain.ai.chat.AiChatSession">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="lastMessagePreview" column="last_message_preview"/>
        <result property="status" column="status"/>
        <result property="messageCount" column="message_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="lastMessageAt" column="last_message_at"/>
    </resultMap>

    <sql id="selectAiChatSessionVo">
        select id,
               user_id,
               title,
               last_message_preview,
               status,
               message_count,
               created_at,
               updated_at,
               last_message_at
        from ai_chat_sessions
    </sql>

    <!-- 按 ID 查询会话，用于归属校验。 -->
    <select id="selectAiChatSessionById" parameterType="String" resultMap="AiChatSessionResult">
        <include refid="selectAiChatSessionVo"/>
        where id = cast(#{id} as uuid)
    </select>

    <!-- 查询用户会话列表，按最近更新时间排序。 -->
    <select id="selectAiChatSessionList"
            parameterType="com.egg.commerce.system.domain.ai.chat.AiChatSession"
            resultMap="AiChatSessionResult">
        <include refid="selectAiChatSessionVo"/>
        <where>
            <if test="id != null and id != ''">
                and id = cast(#{id} as uuid)
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by updated_at desc
    </select>

    <!-- 创建新的聊天会话。 -->
    <insert id="insertAiChatSession" parameterType="com.egg.commerce.system.domain.ai.chat.AiChatSession">
        insert into ai_chat_sessions (
            id,
            user_id,
            title,
            last_message_preview,
            status,
            message_count,
            created_at,
            updated_at,
            last_message_at
        ) values (
            cast(#{id} as uuid),
            #{userId},
            #{title},
            #{lastMessagePreview},
            #{status},
            #{messageCount},
            #{createdAt},
            #{updatedAt},
            #{lastMessageAt}
        )
    </insert>

    <!-- 更新会话摘要、消息数和最近消息时间。 -->
    <update id="updateAiChatSession" parameterType="com.egg.commerce.system.domain.ai.chat.AiChatSession">
        update ai_chat_sessions
        set title = #{title},
            last_message_preview = #{lastMessagePreview},
            status = #{status},
            message_count = #{messageCount},
            created_at = #{createdAt},
            updated_at = #{updatedAt},
            last_message_at = #{lastMessageAt}
        where id = cast(#{id} as uuid)
    </update>

</mapper>
