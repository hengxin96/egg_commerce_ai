<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.egg.commerce.system.mapper.ai.sensitive.AiSensitiveCategoryMapper">

    <!-- 敏感词分类 SQL 映射，支持后台分类维护和删除前关联检查。 -->
    <resultMap id="AiSensitiveCategoryResult" type="com.egg.commerce.system.domain.ai.sensitive.AiSensitiveCategory">
        <id property="id" column="id"/>
        <result property="categoryName" column="category_name"/>
        <result property="status" column="status"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectAiSensitiveCategoryVo">
        select id,
               category_name,
               status,
               created_by,
               created_at,
               updated_at
        from ai_sensitive_categories
    </sql>

    <!-- 按 ID 查询敏感词分类详情。 -->
    <select id="selectAiSensitiveCategoryById" parameterType="Long" resultMap="AiSensitiveCategoryResult">
        <include refid="selectAiSensitiveCategoryVo"/>
        where id = #{id}
    </select>

    <!-- 后台敏感词分类列表查询，支持名称和状态筛选。 -->
    <select id="selectAiSensitiveCategoryList"
            parameterType="com.egg.commerce.system.domain.ai.sensitive.AiSensitiveCategory"
            resultMap="AiSensitiveCategoryResult">
        <include refid="selectAiSensitiveCategoryVo"/>
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="categoryName != null and categoryName != ''">
                and category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by created_at desc
    </select>

    <!-- 新增敏感词分类。 -->
    <insert id="insertAiSensitiveCategory"
            parameterType="com.egg.commerce.system.domain.ai.sensitive.AiSensitiveCategory"
            useGeneratedKeys="true"
            keyProperty="id">
        insert into ai_sensitive_categories (
            category_name,
            status,
            created_by,
            created_at,
            updated_at
        ) values (
            #{categoryName},
            #{status},
            #{createdBy},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <!-- 更新敏感词分类名称或状态。 -->
    <update id="updateAiSensitiveCategory"
            parameterType="com.egg.commerce.system.domain.ai.sensitive.AiSensitiveCategory">
        update ai_sensitive_categories
        <set>
            <if test="categoryName != null">
                category_name = #{categoryName},
            </if>
            <if test="status != null and status != ''">
                status = #{status},
            </if>
            updated_at = #{updatedAt}
        </set>
        where id = #{id}
    </update>

    <!-- 删除分类前统计关联词条，避免留下无归属敏感词。 -->
    <select id="countAiSensitiveWordsByCategoryIds" parameterType="Long" resultType="int">
        select count(1)
        from ai_sensitive_words
        where category_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量删除敏感词分类。 -->
    <delete id="deleteAiSensitiveCategoryByIds" parameterType="Long">
        delete from ai_sensitive_categories
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
